libXt: export _XtInherit through its data-section trampoline on MinGW too.

Widget class records take XtInherit* (_XtInherit) in static initializers.
Across a PE DLL boundary those resolve to the client's import thunk, not
libXt's function, so libXt no longer recognises them and calls
_XtInherit ("Unresolved inheritance operation"). Upstream's WIN32/Cygwin
trampoline makes _XtInherit a data symbol, which auto-import resolves to
the one real address. The Windows build compiles libXt with -std=c99,
where only _WIN32 is predefined (and asm is spelled __asm__), so key it
on that as well.

--- a/Initialize.c	2026-10-08 07:03:30.933073772 +0000
+++ b/Initialize.c	2026-10-08 07:03:55.367384158 +0000
@@ -146,7 +146,7 @@
 }
 
 
-#if defined (WIN32) || defined(__CYGWIN__)
+#if defined (WIN32) || defined(__CYGWIN__) || defined(_WIN32)
 /*
  * The Symbol _XtInherit is used in two different manners.
  * First it could be used as a generic function and second
@@ -196,14 +196,14 @@
  */
 
 #ifdef __x86_64__
-asm(".section .trampoline, \"dwx\" \n\
+__asm__(".section .trampoline, \"dwx\" \n\
  .globl _XtInherit        \n\
  _XtInherit:              \n\
     jmp *_y(%rip)         \n\
 _y: .quad __XtInherit     \n\
     .text                 \n");
 #else
-asm(".data\n\
+__asm__(".data\n\
  .globl __XtInherit        \n\
  __XtInherit:      jmp *_y \n\
   _y: .long ___XtInherit   \n\
